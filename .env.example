# FastAPI Gateway Settings (SportsAgenticAgent connects to http://localhost:8081/v1)
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO

# Model Settings (microsoft/Phi-4-mini-instruct)
MODEL_ID=microsoft/Phi-4-mini-instruct
MODEL_ALIAS=local-model
HF_GGUF_REPO=bartowski/microsoft_Phi-4-mini-instruct-GGUF
HF_GGUF_FILENAME=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf
MODEL_CACHE_DIR=models
AUTO_DOWNLOAD_MODEL=true
# Optional Hugging Face token for authenticated/higher-rate-limit downloads
HF_TOKEN=

# Internal llama-server Subprocess Settings
LLAMA_SERVER_BIN=llama-server
LLAMA_INTERNAL_HOST=127.0.0.1
LLAMA_INTERNAL_PORT=8082
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=4
LLAMA_N_GPU_LAYERS=0
LLAMA_STARTUP_TIMEOUT_SECONDS=60.0
LLAMA_REQUEST_TIMEOUT_SECONDS=60.0
AUTO_START_LLAMA_SERVER=true
# Optional override if connecting to an externally managed llama-server instance
EXTERNAL_LLAMA_URL=
